# Copy to `.env` and edit for your machine. Loaded automatically by uvicorn
# when you start the server with `--env-file .env`.

# Inference device: cuda | mps | cpu
STYLIZEIT_DEVICE=cuda

# Override default folders (absolute paths recommended)
# STYLIZEIT_MODELS_DIR=D:\stylizeit_models
# STYLIZEIT_DATA_DIR=D:\stylizeit_data
# STYLIZEIT_ARTIFACTS_DIR=D:\stylizeit_artifacts

# CORS: comma-separated origins the API allows. "*" allows all (dev only).
STYLIZEIT_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,*

# --- Wan VACE (Alibaba DashScope) — required when using configs/wan_vace.yaml ---
# API key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Public HTTPS URL where THIS server's /artifacts/ is reachable (NOT http://localhost).
# Example with ngrok:  STYLIZEIT_PUBLIC_BASE_URL=https://abc123.ngrok-free.app
STYLIZEIT_PUBLIC_BASE_URL=
